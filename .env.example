# Configure the application environment
NUXT_PUBLIC_APP_ENV=production

# b10cks API URL, only change if you self host the API
NUXT_B10CKS_API_URL=https://api.b10cks.com/api

# Paste your b10cks API token here
NUXT_B10CKS_API_TOKEN=

# b10cks image API URL, only change if you self host the API
NUXT_ILUM_BASE_URL=https://api.b10cks.com/ilum

# Your wesite URL
NUXT_SITE_URL=
